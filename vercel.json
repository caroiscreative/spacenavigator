{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build && vite build --config vite.embed.config.js --emptyOutDir false && cp dist-embed/spacenavigator-embed.js dist/",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,

  "rewrites": [
    {
      "source": "/celestrak/:path*",
      "destination": "/api/celestrak?proxyPath=:path*"
    },
    {
      "source": "/sdo/:path*",
      "destination": "/api/sdo?proxyPath=:path*"
    },
    {
      "source": "/swpc/:path*",
      "destination": "/api/swpc?proxyPath=:path*"
    }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/spacenavigator-embed.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
